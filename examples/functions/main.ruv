craft factorial(n: int) -> int {
    check n <= 1 {
        give 1;
    } otherwise {
        give n * factorial(n - 1);
    }
}

craft repeat(word: text, count: int) -> text {
    vary result = "";

    walk index from 0 until count {
        result = result + word;
    }

    give result;
}

launch() {
    show(factorial(5), repeat("ru", 3));
}
