object Values { low: int; zero: real; large: real; small: real; infinity: real; truth: bool; }
launch() {
    keep item = Values { low: -2147483648, zero: -0.0, large: 100000000000000000000.0,
        small: 0.1, infinity: .0 * .0, truth: false };
    walk field in item { show(field.key, field.value); }
}
